# Salin file ini menjadi .env.local lalu isi. Jangan pernah commit .env.local.

# Penyedia AI: "groq" atau "anthropic". Bila kosong: Groq dipakai jika hanya GROQ_API_KEY yang diisi.
# AI_PROVIDER=groq

# --- Groq (ada paket gratis; kuota kecil dan bisa berubah) ---
# Paket gratis saat ini: 8.000 token/menit dan 200.000 token/hari per organisasi (cek console.groq.com/settings/limits).
GROQ_API_KEY=
# Model untuk LP dan LK (default: openai/gpt-oss-120b). llama-3.3-70b-versatile sudah ditutup Groq.
# GROQ_MODEL=
# Model untuk Reading Journal (default: openai/gpt-oss-120b)
# GROQ_MODEL_LONG=
# Batas karakter teks jurnal yang dikirim ke Groq (default 14000 agar muat di paket gratis; di paket berbayar boleh 60000)
# GROQ_JOURNAL_CHARS=14000

# --- Anthropic (Claude), berbayar per pemakaian ---
ANTHROPIC_API_KEY=

# Opsional: ganti model (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=

# Sangat disarankan bila aplikasi bisa diakses orang lain (belum ada login):
# semua API menolak permintaan tanpa kode ini. Mahasiswa mengisinya di menu Pengaturan.
# ACCESS_CODE=

# Opsional: batas permintaan per IP per jam (default 200)
# RATE_LIMIT_PER_HOUR=200

# Opsional: email kontak untuk "polite pool" Crossref (pencarian DOI lebih stabil)
# CROSSREF_MAILTO=

# Opsional: batas durasi fungsi untuk /api/generate (route mengekspor maxDuration = 60 detik).
# Anggaran waktu satu bagian (ms, default 50000, maksimum 55000). Setelah habis server membalas 504 "waktu habis" yang aman dicoba ulang.
# NAKESA_GENERATE_BUDGET_MS=50000

# Hanya untuk uji alur tanpa memakai AI/biaya (teks contoh). Jangan aktifkan di produksi.
# NAKESA_MOCK_AI=1
